{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@dartfit/engine": ["packages/engine/src/index.ts"],
      "@dartfit/catalogue": ["packages/catalogue/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/api/src",
    "apps/api/test",
    "apps/web/src",
    "apps/web/test",
    "scripts"
  ]
}
