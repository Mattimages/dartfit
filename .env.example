# Copy to .env and fill in. Everything except the production trio below has a working default.

# ── Required in production ───────────────────────────────────────────
NODE_ENV=production
PUBLIC_URL=https://dartfit.nl
DATABASE_URL=postgres://dartfit:password@host:5432/dartfit
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────
PORT=3000
TRUST_PROXY=true
# Run the background jobs (link checks, price alerts, retention) in the web process.
RUN_WORKER=true
DEFAULT_COUNTRY=NL
ADMIN_EMAILS=
COMPANY_LINE=DartFit · KvK 00000000 · contact@dartfit.nl

# ── AI explanation (optional; without it a template explanation is used) ──
ANTHROPIC_API_KEY=
EXPLAIN_MODEL=claude-haiku-5-5

# ── Sign-in links and alerts (optional) ──────────────────────────────
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=DartFit <noreply@dartfit.nl>
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@dartfit.nl

# ── Affiliate programmes ─────────────────────────────────────────────
# Only shops with an affiliate programme are linked, and in production a shop appears only once its
# ID is set here. The shop list per country is packages/catalogue/data/retailers.json.
# Darts specialists (network deeplink templates: paste the template from the network, with {url}):
DARTSCORNER_DEEPLINK=        # Adtraction, EU storefront (dartscorner.de)
DARTSCORNER_UK_DEEPLINK=     # Adtraction, UK storefront
DARTSTURM_DEEPLINK=          # Shopper.com, DE/AT
# bol.com Partner Programme (NL/BE):
BOL_PARTNER_SITE_ID=
# Amazon Associates, one per marketplace:
AMAZON_TAG_NL=
AMAZON_TAG_BE=
AMAZON_TAG_DE=
AMAZON_TAG_US=
# Darting.com (US) in-house affiliate ID, e.g. 4311
DARTING_AFF_ID=
AMAZON_TAG_FR=
AMAZON_TAG_IT=
AMAZON_TAG_ES=
AMAZON_TAG_SE=
AMAZON_TAG_PL=
AMAZON_TAG_UK=
# eBay Partner Network (one campaign ID for all eBay sites):
EBAY_CAMPAIGN_ID=

# Product photos are served through /img (our own origin). On by default; set false to show only
# photos marked cleared=yes in packages/catalogue/data/photos.csv (affiliate-feed images).
PREVIEW_PHOTOS=true
